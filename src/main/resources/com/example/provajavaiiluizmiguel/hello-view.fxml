<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="530.0" prefWidth="579.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.provajavaiiluizmiguel.Controler.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <TextField fx:id="idNomePassageiro" promptText="Nome do passageiro" />
      <TextField fx:id="idCPF" promptText="CPF" />
      <TextField fx:id="idOrigem" promptText="Origem" />
      <TextField fx:id="idDestino" promptText="Destino" />
      <TextField fx:id="idDataCorrida" promptText="data da corrida" />
      <TextField fx:id="idDistanciaCorrida" promptText="Distância da corrida (km)" />
      <ComboBox fx:id="idVeiculoUtilizado" prefWidth="150.0" promptText="Veículo utilizado" />
      <ComboBox fx:id="idCondicaoDemanda" prefWidth="150.0" promptText="Condição de demanda da corrida" />
      <TextField fx:id="idCupomDesconto" promptText="Cupom de desconto" />
      <ComboBox prefWidth="150.0" promptText="Cupom de desconto" />
      <ComboBox fx:id="idValorAcrescimo" prefWidth="150.0" promptText="Valor do acréscimo" />
      <Button fx:id="idConcluirRegistro" mnemonicParsing="false" text="Concluir registro" />
      <TextArea fx:id="idResultado" prefHeight="200.0" prefWidth="200.0" />
   </children>
</VBox>
